  <Box style={{ position: 'absolute', left: 60, top: 170, width: 1160, height: 1, background: '#D6CEC2' }} />

  <Box style={{ position: 'absolute', left: 60, top: 200, width: 540, padding: 28, background: '#F1EDE7', borderRadius: 12, height: 320 }}>
    <Text style={{ fontFamily: 'Source Han Sans, sans-serif', fontSize: 14, color: '#8E8581', letterSpacing: 2 }}>过去 · 传统方式</Text>
    <Text style={{ fontFamily: 'LXGW WenKai, serif', fontSize: 26, color: '#503C36', marginTop: 18, lineHeight: 1.45 }}>写在纸上，压在箱底</Text>
